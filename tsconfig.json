{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test", "scripts", "tsup.config.ts", "vitest.config.ts"],
  // The DOM-driven site test needs the DOM lib, and this config deliberately
  // omits it so that nothing in src/ can depend on a browser global by
  // accident. It is typechecked by test/tsconfig.dom.json instead.
  "exclude": ["test/site-ui.test.ts"]
}
